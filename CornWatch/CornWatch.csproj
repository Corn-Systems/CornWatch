<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>CornWatch</AssemblyName>
    <RootNamespace>CornWatch</RootNamespace>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Optimize>true</Optimize>

    <!-- DPI awareness declared in app.manifest; belt-and-suspenders in Program.cs -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>assets\cornwatch.ico</ApplicationIcon>
    <!-- WFO0003: WinForms obsolete API used internally by WebView2 WinForms wrapper.
         MSB3277: WindowsBase version conflict caused by WebView2 shipping both a WinForms
         and a WPF assembly — the WPF one pulls in a newer WindowsBase. The RemoveWebView2Wpf
         target below drops the WPF assembly, but MSBuild still emits the warning during
         dependency resolution before the target fires, so we suppress it here too. -->
    <NoWarn>$(NoWarn);WFO0003;MSB3277</NoWarn>

    <!-- Single source of truth for the version.  AppInfo.cs reads it via
         AssemblyInformationalVersionAttribute; never hardcode elsewhere. -->
    <Version>0.2.0</Version>
    <Company>Corn Systems</Company>
    <Authors>Corn Systems</Authors>
    <Product>CornWatch</Product>
    <Description>Real-time system health dashboard by Corn Systems</Description>
    <Copyright>© 2026 Corn Systems</Copyright>
    <RepositoryUrl>https://github.com/Corn-Systems/CornWatch</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Corn-Systems/CornWatch</PackageProjectUrl>

    <!-- Publish defaults: single self-contained win-x64 exe.
         `dotnet publish -c Release` → bin\Release\net10.0-windows\win-x64\publish\CornWatch.exe
         The .iss picks it up from there. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Folder on disk is lowercase "assets" — casing must match exactly
         or case-sensitive build environments (Linux CI) fail to find these. -->
    <Content Include="assets\cornwatch.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="assets\cornwatch.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="UI\Dashboard\Dashboard.html">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- WebView2 for the HTML dashboard panel -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <!-- WMI for hardware data (temps, drives) -->
    <PackageReference Include="System.Management" Version="10.0.11" />
    <!-- System.Text.Json ships in-box with net10.0 — no explicit package needed -->
  </ItemGroup>

  <!--
    The WebView2 package ships both a WinForms and a WPF assembly variant.
    MSBuild pulls in Microsoft.Web.WebView2.Wpf.dll even though this is a
    WinForms-only app (UseWPF is never set), and that WPF assembly depends
    on a newer WindowsBase than the WinForms desktop pack provides — causing
    an "MSB3277: conflicts between different versions of WindowsBase" warning.
    Nothing in this project references the Wpf namespace, so drop that
    reference after it's resolved rather than just suppressing the warning.
  -->
  <Target Name="RemoveWebView2Wpf" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferencePath Remove="@(ReferencePath)"
                     Condition="'%(ReferencePath.FileName)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>